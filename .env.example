# Firebase Web App Config (Public Client Config)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_auth_domain_here
VITE_FIREBASE_PROJECT_ID=your_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_storage_bucket_here
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id_here

# NOTE: NVIDIA NIM Secrets MUST remain server-side in functions/.env or Firebase Secrets Manager.
# NEVER place NVIDIA_NIM_API_KEY in this file or use VITE_ prefix.

# ─── Member 2: Attendance Local Development Mode ──────────────────────────────
# Set to 'true' in .env.local (git-ignored) to run Attendance with in-memory
# sample data — no Firebase Auth or Firestore required.
# Leave unset (or 'false') for production Firebase mode.
# VITE_ATTENDANCE_LOCAL_DEV=true
